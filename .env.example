# Free key from https://console.groq.com -> API Keys
# Used for speech-to-text (Whisper), chat completions (Llama) and TTS (Orpheus).
GROQ_API_KEY=gsk_your_key_here

# --- optional ------------------------------------------------------------- #

# Text-to-speech provider:
#   auto  (default) try Groq, fall back to gTTS
#   groq            Groq only - returns WAV, works from cloud hosts
#   gtts            gTTS only - free and keyless, unreliable from datacenter IPs
# TTS_PROVIDER=auto
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=tara
# GROQ_TTS_FORMAT=wav

# Set once deployed to a public URL, otherwise anyone who finds the URL can spend
# your Groq quota. The ESP32 must then send it as an X-API-Key header.
# API_SECRET=some-long-random-string

# Set automatically by Render/Railway/Fly; only needed if you run `python main.py`.
# PORT=8000
